{
   "compilerOptions": {
      "strict": true,
      "target": "es2019",
      "lib": ["es2019", "dom", "dom.iterable"],
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "jsx": "react-jsx",
      "skipLibCheck": true,
      "noEmit": true,
      "baseUrl": ".",
      "paths": {
         "verdux": ["../../src/index.ts"],
         "react": ["./node_modules/@types/react"],
         "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
         "observable-hooks": ["./node_modules/observable-hooks"]
      }
   },
   "include": [
      "**/*.ts",
      "**/*.tsx",
      "../skills/**/*.ts",
      "../skills/**/*.tsx"
   ],
   "exclude": ["node_modules"]
}
